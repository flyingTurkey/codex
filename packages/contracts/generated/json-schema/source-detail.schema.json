{
  "$defs": {
    "AuthorityLevel": {
      "enum": [
        "A0",
        "A1",
        "B1",
        "B2",
        "C1",
        "C2"
      ],
      "title": "AuthorityLevel",
      "type": "string"
    },
    "SourceChannel": {
      "enum": [
        "DIGITAL",
        "SAFETY",
        "BOTH"
      ],
      "title": "SourceChannel",
      "type": "string"
    },
    "SourceEligibility": {
      "additionalProperties": false,
      "properties": {
        "effective_active": {
          "title": "Effective Active",
          "type": "boolean"
        },
        "fixture_count": {
          "minimum": 0,
          "title": "Fixture Count",
          "type": "integer"
        },
        "fixture_set_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Set Sha256"
        },
        "missing_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Missing Reasons",
          "type": "array"
        },
        "onboarding_policy_matches": {
          "title": "Onboarding Policy Matches",
          "type": "boolean"
        },
        "onboarding_valid": {
          "title": "Onboarding Valid",
          "type": "boolean"
        },
        "policy_valid": {
          "title": "Policy Valid",
          "type": "boolean"
        },
        "required_checks_complete": {
          "title": "Required Checks Complete",
          "type": "boolean"
        },
        "required_fixture_count": {
          "default": 30,
          "title": "Required Fixture Count",
          "type": "integer"
        }
      },
      "required": [
        "effective_active",
        "policy_valid",
        "onboarding_valid",
        "onboarding_policy_matches",
        "required_checks_complete",
        "fixture_count",
        "missing_reasons"
      ],
      "title": "SourceEligibility",
      "type": "object"
    },
    "SourceState": {
      "enum": [
        "CANDIDATE",
        "COMPLIANCE_REVIEW",
        "FIXTURE_TEST",
        "APPROVED",
        "ACTIVE"
      ],
      "title": "SourceState",
      "type": "string"
    },
    "SourceType": {
      "enum": [
        "government",
        "standards",
        "journal",
        "research_institute",
        "association",
        "enterprise",
        "media",
        "academic_api",
        "academic_database"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority_level": {
      "$ref": "#/$defs/AuthorityLevel"
    },
    "base_url": {
      "title": "Base Url",
      "type": "string"
    },
    "channel": {
      "$ref": "#/$defs/SourceChannel"
    },
    "collection_method": {
      "title": "Collection Method",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "effective_active": {
      "title": "Effective Active",
      "type": "boolean"
    },
    "eligibility": {
      "$ref": "#/$defs/SourceEligibility"
    },
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "fixture_count": {
      "minimum": 0,
      "title": "Fixture Count",
      "type": "integer"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "owner": {
      "title": "Owner",
      "type": "string"
    },
    "poll_interval_minutes": {
      "title": "Poll Interval Minutes",
      "type": "integer"
    },
    "priority": {
      "title": "Priority",
      "type": "string"
    },
    "registry_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Registry Code"
    },
    "source_type": {
      "$ref": "#/$defs/SourceType"
    },
    "state": {
      "$ref": "#/$defs/SourceState"
    }
  },
  "required": [
    "id",
    "registry_code",
    "name",
    "base_url",
    "channel",
    "source_type",
    "authority_level",
    "priority",
    "state",
    "enabled",
    "effective_active",
    "fixture_count",
    "created_at",
    "collection_method",
    "poll_interval_minutes",
    "owner",
    "eligibility"
  ],
  "title": "SourceDetail",
  "type": "object"
}
