{
  "$defs": {
    "ReviewStatus": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assigned_to": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assigned To"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "item_id": {
      "format": "uuid",
      "title": "Item Id",
      "type": "string"
    },
    "risk_level": {
      "$ref": "#/$defs/RiskLevel"
    },
    "source_name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Source Name",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReviewStatus"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    },
    "submitted_by": {
      "format": "uuid",
      "title": "Submitted By",
      "type": "string"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id",
    "item_id",
    "status",
    "risk_level",
    "title",
    "source_name",
    "submitted_by",
    "submitted_at"
  ],
  "title": "ReviewTaskSummary",
  "type": "object"
}
