{
  "$defs": {
    "OperatorTaskStatus": {
      "enum": [
        "PENDING",
        "IN_PROGRESS",
        "COMPLETED"
      ],
      "title": "OperatorTaskStatus",
      "type": "string"
    },
    "OperatorWorkCategory": {
      "enum": [
        "SOURCE_MAINTENANCE",
        "EXCEPTION_HANDLING",
        "R3_REVIEW",
        "COPYRIGHT_CORRECTION"
      ],
      "title": "OperatorWorkCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assigned_to": {
      "format": "uuid",
      "title": "Assigned To",
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/OperatorWorkCategory"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "completed_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed By"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "format": "uuid",
      "title": "Created By",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "source_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Id"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/OperatorTaskStatus"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "window_id": {
      "format": "uuid",
      "title": "Window Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "window_id",
    "category",
    "assigned_to",
    "status",
    "created_by",
    "created_at"
  ],
  "title": "OperatorTaskView",
  "type": "object"
}
