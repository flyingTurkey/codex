          "format": "uuid",
          "title": "Attribution Entity Id",
          "type": "string"
        },
        "independent_evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Independent Evidence Ids",
          "type": "array"
        },
        "outcome_id": {
          "format": "uuid",
          "title": "Outcome Id",
          "type": "string"
