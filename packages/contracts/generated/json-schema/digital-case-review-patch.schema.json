      "maxItems": 30,
      "title": "Application Scenarios",
      "type": "array"
    },
    "engineering_domains": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Engineering Domains",
      "type": "array"
    },
    "lifecycle_stages": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Lifecycle Stages",
      "type": "array"
    },
    "maturity_evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Maturity Evidence Ids",
      "type": "array"
    },
    "maturity_level": {
      "$ref": "#/$defs/MaturityLevel"
