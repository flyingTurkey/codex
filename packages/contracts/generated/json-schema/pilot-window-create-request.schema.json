{
  "additionalProperties": false,
  "properties": {
    "baseline_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Baseline Commit",
      "type": "string"
    },
    "config_version": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9._-]+$",
      "title": "Config Version",
      "type": "string"
    },
    "database_revision": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9._-]+$",
      "title": "Database Revision",
      "type": "string"
    },
    "duration_hours": {
      "const": 168,
      "default": 168,
      "title": "Duration Hours",
      "type": "integer"
    },
    "environment": {
      "const": "PREPRODUCTION",
      "default": "PREPRODUCTION",
      "title": "Environment",
      "type": "string"
    },
    "gold_definition_version": {
      "maxLength": 80,
      "pattern": "^phase2-round17-gold-v\\d+\\.\\d+\\.\\d+$",
      "title": "Gold Definition Version",
      "type": "string"
    },
    "metric_definition_version": {
      "maxLength": 80,
      "pattern": "^phase2-round17-metrics-v\\d+\\.\\d+\\.\\d+$",
      "title": "Metric Definition Version",
      "type": "string"
    },
    "reason": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "roster_version": {
      "maxLength": 80,
      "pattern": "^r17-sources-v\\d+\\.\\d+$",
      "title": "Roster Version",
      "type": "string"
    },
    "source_codes": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 20,
      "title": "Source Codes",
      "type": "array"
    }
  },
  "required": [
    "roster_version",
    "metric_definition_version",
    "gold_definition_version",
    "baseline_commit",
    "config_version",
    "database_revision",
    "source_codes",
    "reason"
  ],
  "title": "PilotWindowCreateRequest",
  "type": "object"
}
