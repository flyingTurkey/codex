{
  "$defs": {
    "SourceCandidateDecisionItemOutcome": {
      "enum": [
        "APPLIED",
        "CONFLICT",
        "REJECTED"
      ],
      "title": "SourceCandidateDecisionItemOutcome",
      "type": "string"
    },
    "SourceCandidateDecisionItemResult": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/SourceCandidateDecisionItemOutcome"
        },
        "production_refetch_enqueued": {
          "title": "Production Refetch Enqueued",
          "type": "boolean"
        },
        "reason_code": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "source_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceCandidateStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "candidate_id",
        "outcome",
        "production_refetch_enqueued"
      ],
      "title": "SourceCandidateDecisionItemResult",
      "type": "object"
    },
    "SourceCandidateStatus": {
      "enum": [
        "DISCOVERED",
        "QUALIFYING",
        "READY_FOR_DECISION",
        "ENABLED",
        "DISMISSED",
        "BLOCKED",
        "STALE"
      ],
      "title": "SourceCandidateStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "idempotent_replay": {
      "title": "Idempotent Replay",
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SourceCandidateDecisionItemResult"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "rule_version": {
      "title": "Rule Version",
      "type": "string"
    }
  },
  "required": [
    "items",
    "rule_version",
    "decided_at",
    "idempotent_replay"
  ],
  "title": "SourceCandidateBatchDecisionResult",
  "type": "object"
}
