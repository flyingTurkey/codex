{
  "$defs": {
    "GoldSampleKind": {
      "enum": [
        "DOCUMENT",
        "PAIR",
        "EVENT",
        "CLAIM_EVIDENCE",
        "SEARCH_QUESTION"
      ],
      "title": "GoldSampleKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision_code": {
      "pattern": "^[A-Z][A-Z0-9_]{1,79}$",
      "title": "Decision Code",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Evidence Ids",
      "type": "array"
    },
    "label_value": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label Value"
    },
    "related_sample_refs": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Related Sample Refs",
      "type": "array"
    },
    "sample_kind": {
      "$ref": "#/$defs/GoldSampleKind"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "sample_kind",
    "decision_code"
  ],
  "title": "GoldAnnotationRequest",
  "type": "object"
}
