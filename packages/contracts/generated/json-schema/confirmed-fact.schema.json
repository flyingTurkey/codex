{
  "$defs": {
    "SafetyCaseFactField": {
      "enum": [
        "OCCURRED_AT",
        "REGION",
        "PROJECT_NAME",
        "HAZARD_TYPE",
        "ENGINEERING_TYPE",
        "DEATH_COUNT",
        "INJURY_COUNT",
        "LOSS_AMOUNT_MINOR",
        "OFFICIAL_DIRECT_CAUSES",
        "RESPONSIBILITY_FINDINGS",
        "CORRECTIVE_ACTIONS"
      ],
      "title": "SafetyCaseFactField",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "format": "uuid",
      "title": "Claim Id",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "field": {
      "$ref": "#/$defs/SafetyCaseFactField"
    },
    "label": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "source_item_id": {
      "format": "uuid",
      "title": "Source Item Id",
      "type": "string"
    },
    "status": {
      "const": "CONFIRMED",
      "default": "CONFIRMED",
      "title": "Status",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "maxLength": 30,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "source_item_id",
    "claim_id",
    "field",
    "label",
    "value",
    "evidence_ids",
    "reviewed_at"
  ],
  "title": "ConfirmedFact",
  "type": "object"
}
