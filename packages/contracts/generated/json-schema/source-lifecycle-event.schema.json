{
  "$defs": {
    "SourceLifecycleAction": {
      "enum": [
        "SUBMIT_COMPLIANCE",
        "START_FIXTURE_TRIAL",
        "START_LIVE_TRIAL",
        "APPROVE_PRODUCTION",
        "PAUSE",
        "RESUME",
        "RETIRE"
      ],
      "title": "SourceLifecycleAction",
      "type": "string"
    },
    "SourceLifecycleState": {
      "description": "Authoritative V2 source lifecycle computed by the server.",
      "enum": [
        "CANDIDATE",
        "COMPLIANCE_REVIEW",
        "TRIAL",
        "ACTIVE",
        "PAUSED",
        "RETIRED"
      ],
      "title": "SourceLifecycleState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceLifecycleAction"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Actor Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "from_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceLifecycleState"
        },
        {
          "type": "null"
        }
      ]
    },
    "governance_decision_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Governance Decision Id"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "migration_rule_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Migration Rule Version"
    },
    "policy_version_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Version Id"
    },
    "reason": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Reason Code",
      "type": "string"
    },
    "source_id": {
      "format": "uuid",
      "title": "Source Id",
      "type": "string"
    },
    "to_state": {
      "$ref": "#/$defs/SourceLifecycleState"
    }
  },
  "required": [
    "id",
    "source_id",
    "from_state",
    "to_state",
    "action",
    "reason_code",
    "reason",
    "actor_id",
    "created_at"
  ],
  "title": "SourceLifecycleEventView",
  "type": "object"
}
