      "enum": [
        "MERGE",
        "SPLIT",
        "KEEP_DISTINCT",
        "LINK_RELATION"
      ],
      "title": "Action",
      "type": "string"
    },
    "member_ids": {
      "items": {
        "format": "uuid",
