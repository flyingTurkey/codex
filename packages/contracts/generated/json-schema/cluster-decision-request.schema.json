      },
      "maxItems": 1000,
      "minItems": 2,
      "title": "Member Ids",
      "type": "array"
    },
    "reason": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "relation_type": {
      "anyOf": [
        {
          "maxLength": 50,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relation Type"
    }
  },
  "required": [
    "action",
    "member_ids",
    "reason"
  ],
  "title": "ClusterDecisionRequest",
  "type": "object"
