{
  "$defs": {
    "Channel": {
      "enum": [
        "DIGITAL",
        "SAFETY"
      ],
      "title": "Channel",
      "type": "string"
    },
    "GoldSampleKind": {
      "enum": [
        "DOCUMENT",
        "PAIR",
        "EVENT",
        "CLAIM_EVIDENCE",
        "SEARCH_QUESTION"
      ],
      "title": "GoldSampleKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assigned_annotator_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Assigned Annotator Ids",
      "type": "array"
    },
    "critical_safety": {
      "default": false,
      "title": "Critical Safety",
      "type": "boolean"
    },
    "domain": {
      "$ref": "#/$defs/Channel"
    },
    "production_decision_id": {
      "format": "uuid",
      "title": "Production Decision Id",
      "type": "string"
    },
    "reason": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "sample_kind": {
      "$ref": "#/$defs/GoldSampleKind"
    },
    "sample_ref": {
      "maxLength": 140,
      "pattern": "^urn:srbg:(document|pair|event|claim-evidence|search-question):[0-9a-f-]{36}(?::[0-9a-f-]{36})?$",
      "title": "Sample Ref",
      "type": "string"
    },
    "secondary_review_required": {
      "default": false,
      "title": "Secondary Review Required",
      "type": "boolean"
    },
    "source_code": {
      "pattern": "^[A-Z]{3}-[0-9]{3}$",
      "title": "Source Code",
      "type": "string"
    }
  },
  "required": [
    "sample_kind",
    "sample_ref",
    "source_code",
    "domain",
    "production_decision_id",
    "assigned_annotator_ids",
    "reason"
  ],
  "title": "GoldTaskCreateRequest",
  "type": "object"
}
