{
  "$defs": {
    "AuthorityLevel": {
      "enum": [
        "A0",
        "A1",
        "B1",
        "B2",
        "C1",
        "C2",
        "UNKNOWN"
      ],
      "title": "AuthorityLevel",
      "type": "string"
    },
    "SourceChannel": {
      "enum": [
        "DIGITAL",
        "SAFETY",
        "BOTH"
      ],
      "title": "SourceChannel",
      "type": "string"
    },
    "SourceContentDomain": {
      "enum": [
        "DIGITAL_TRANSFORMATION_CASE",
        "RESEARCH_PAPER",
        "SOFTWARE_PLATFORM",
        "IOT_EQUIPMENT",
        "LOW_ALTITUDE_EQUIPMENT",
        "AI_APPLICATION",
        "SAFETY_REGULATION",
        "STANDARD_GUIDANCE",
        "ACCIDENT_INVESTIGATION",
        "OFFICIAL_NOTICE",
        "PENALTY",
        "RECTIFICATION",
        "UNKNOWN"
      ],
      "title": "SourceContentDomain",
      "type": "string"
    },
    "SourceDeclaredRole": {
      "enum": [
        "OFFICIAL_PRIMARY",
        "OFFICIAL_SECONDARY",
        "STANDARDS_PUBLISHER",
        "RESEARCH_PUBLISHER",
        "MANUFACTURER",
        "INDEPENDENT_REPORTER",
        "AGGREGATOR",
        "UNKNOWN"
      ],
      "title": "SourceDeclaredRole",
      "type": "string"
    },
    "SourceIndustry": {
      "enum": [
        "HIGHWAY",
        "BRIDGE",
        "TUNNEL",
        "RAILWAY",
        "RAIL_TRANSIT",
        "WATER_CONSERVANCY",
        "MUNICIPAL",
        "BUILDING",
        "ENERGY",
        "PORT_WATERWAY",
        "AIRPORT",
        "GENERAL_TRANSPORT",
        "UNKNOWN"
      ],
      "title": "SourceIndustry",
      "type": "string"
    },
    "SourceType": {
      "enum": [
        "government",
        "standards",
        "journal",
        "research_institute",
        "association",
        "enterprise",
        "media",
        "academic_api",
        "academic_database"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority_level": {
      "$ref": "#/$defs/AuthorityLevel"
    },
    "base_url": {
      "maxLength": 2048,
      "pattern": "^https?://[^\\s]+$",
      "title": "Base Url",
      "type": "string"
    },
    "channel": {
      "$ref": "#/$defs/SourceChannel"
    },
    "collection_method": {
      "maxLength": 50,
      "minLength": 1,
      "title": "Collection Method",
      "type": "string"
    },
    "content_domains": {
      "items": {
        "$ref": "#/$defs/SourceContentDomain"
      },
      "maxItems": 30,
      "title": "Content Domains",
      "type": "array"
    },
    "country_codes": {
      "items": {
        "pattern": "^[A-Z]{2}$",
        "type": "string"
      },
      "maxItems": 20,
      "title": "Country Codes",
      "type": "array"
    },
    "declared_roles": {
      "items": {
        "$ref": "#/$defs/SourceDeclaredRole"
      },
      "maxItems": 20,
      "title": "Declared Roles",
      "type": "array"
    },
    "governance_owner_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Governance Owner Id"
    },
    "industries": {
      "items": {
        "$ref": "#/$defs/SourceIndustry"
      },
      "maxItems": 20,
      "title": "Industries",
      "type": "array"
    },
    "language_tags": {
      "items": {
        "maxLength": 35,
        "minLength": 2,
        "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
        "type": "string"
      },
      "maxItems": 20,
      "title": "Language Tags",
      "type": "array"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "owner": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Owner",
      "type": "string"
    },
    "poll_interval_minutes": {
      "maximum": 10080,
      "minimum": 1,
      "title": "Poll Interval Minutes",
      "type": "integer"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ],
      "title": "Priority",
      "type": "string"
    },
    "region_codes": {
      "items": {
        "maxLength": 16,
        "minLength": 2,
        "pattern": "^[A-Z0-9]{2,3}(?:-[A-Z0-9]{1,6})?$",
        "type": "string"
      },
      "maxItems": 50,
      "title": "Region Codes",
      "type": "array"
    },
    "source_type": {
      "$ref": "#/$defs/SourceType"
    }
  },
  "required": [
    "name",
    "base_url",
    "channel",
    "source_type",
    "authority_level",
    "priority",
    "collection_method",
    "poll_interval_minutes",
    "owner"
  ],
  "title": "CreateSourceRequest",
  "type": "object"
}
