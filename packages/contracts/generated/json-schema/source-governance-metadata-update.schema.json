{
  "$defs": {
    "SourceContentDomain": {
      "enum": [
        "DIGITAL_TRANSFORMATION_CASE",
        "RESEARCH_PAPER",
        "SOFTWARE_PLATFORM",
        "IOT_EQUIPMENT",
        "LOW_ALTITUDE_EQUIPMENT",
        "AI_APPLICATION",
        "SAFETY_REGULATION",
        "STANDARD_GUIDANCE",
        "ACCIDENT_INVESTIGATION",
        "OFFICIAL_NOTICE",
        "PENALTY",
        "RECTIFICATION",
        "UNKNOWN"
      ],
      "title": "SourceContentDomain",
      "type": "string"
    },
    "SourceDeclaredRole": {
      "enum": [
        "OFFICIAL_PRIMARY",
        "OFFICIAL_SECONDARY",
        "STANDARDS_PUBLISHER",
        "RESEARCH_PUBLISHER",
        "MANUFACTURER",
        "INDEPENDENT_REPORTER",
        "AGGREGATOR",
        "UNKNOWN"
      ],
      "title": "SourceDeclaredRole",
      "type": "string"
    },
    "SourceIndustry": {
      "enum": [
        "HIGHWAY",
        "BRIDGE",
        "TUNNEL",
        "RAILWAY",
        "RAIL_TRANSIT",
        "GENERAL_TRANSPORT",
        "UNKNOWN"
      ],
      "title": "SourceIndustry",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Governance-owned coverage metadata; lifecycle authority is intentionally absent.",
  "properties": {
    "content_domains": {
      "items": {
        "$ref": "#/$defs/SourceContentDomain"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Content Domains",
      "type": "array"
    },
    "country_codes": {
      "items": {
        "pattern": "^[A-Z]{2}$",
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Country Codes",
      "type": "array"
    },
    "declared_roles": {
      "items": {
        "$ref": "#/$defs/SourceDeclaredRole"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Declared Roles",
      "type": "array"
    },
    "governance_owner_id": {
      "format": "uuid",
      "title": "Governance Owner Id",
      "type": "string"
    },
    "industries": {
      "items": {
        "$ref": "#/$defs/SourceIndustry"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Industries",
      "type": "array"
    },
    "language_tags": {
      "items": {
        "maxLength": 35,
        "minLength": 2,
        "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Language Tags",
      "type": "array"
    },
    "reason": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "region_codes": {
      "items": {
        "maxLength": 16,
        "minLength": 2,
        "pattern": "^[A-Z0-9]{2,3}(?:-[A-Z0-9]{1,6})?$",
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Region Codes",
      "type": "array"
    }
  },
  "required": [
    "governance_owner_id",
    "country_codes",
    "region_codes",
    "language_tags",
    "industries",
    "content_domains",
    "declared_roles",
    "reason"
  ],
  "title": "SourceGovernanceMetadataUpdate",
  "type": "object"
}
