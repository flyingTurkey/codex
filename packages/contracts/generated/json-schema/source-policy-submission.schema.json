{
  "$defs": {
    "CopyrightPolicy": {
      "additionalProperties": false,
      "properties": {
        "attribution_template": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Attribution Template",
          "type": "string"
        },
        "display_policy": {
          "$ref": "#/$defs/DisplayPolicy"
        },
        "excerpt_max_chars": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Excerpt Max Chars",
          "type": "integer"
        },
        "fulltext_allowed": {
          "title": "Fulltext Allowed",
          "type": "boolean"
        },
        "image_allowed": {
          "title": "Image Allowed",
          "type": "boolean"
        },
        "storage_policy": {
          "$ref": "#/$defs/StoragePolicy"
        }
      },
      "required": [
        "storage_policy",
        "display_policy",
        "fulltext_allowed",
        "image_allowed",
        "excerpt_max_chars",
        "attribution_template"
      ],
      "title": "CopyrightPolicy",
      "type": "object"
    },
    "DisplayPolicy": {
      "enum": [
        "METADATA_EXCERPT_LINK",
        "OFFICIAL_READER_LINK",
        "LINK_ONLY"
      ],
      "title": "DisplayPolicy",
      "type": "string"
    },
    "ReviewEvidence": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Sha256"
        },
        "evidence_url": {
          "maxLength": 2048,
          "pattern": "^https?://[^\\s]+$",
          "title": "Evidence Url",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/ReviewEvidenceResult"
        }
      },
      "required": [
        "result",
        "evidence_url",
        "checked_at"
      ],
      "title": "ReviewEvidence",
      "type": "object"
    },
    "ReviewEvidenceResult": {
      "enum": [
        "ALLOWED",
        "RESTRICTED",
        "NOT_PRESENT",
        "BLOCKED"
      ],
      "title": "ReviewEvidenceResult",
      "type": "string"
    },
    "SourceAccessPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_domains": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Domains",
          "type": "array"
        },
        "rate_limit_per_minute": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Rate Limit Per Minute",
          "type": "integer"
        },
        "requires_auth": {
          "title": "Requires Auth",
          "type": "boolean"
        },
        "user_agent": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "User Agent",
          "type": "string"
        }
      },
      "required": [
        "allowed_domains",
        "requires_auth",
        "rate_limit_per_minute",
        "user_agent"
      ],
      "title": "SourceAccessPolicy",
      "type": "object"
    },
    "SourcePolicyReviewSubmission": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Approval Id",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "valid_until",
        "approval_id"
      ],
      "title": "SourcePolicyReviewSubmission",
      "type": "object"
    },
    "SourcePolicyStatus": {
      "enum": [
        "DRAFT",
        "VALID",
        "EXPIRED",
        "REVOKED"
      ],
      "title": "SourcePolicyStatus",
      "type": "string"
    },
    "StoragePolicy": {
      "enum": [
        "RAW_EVIDENCE_ALLOWED",
        "METADATA_ONLY",
        "LINK_ONLY"
      ],
      "title": "StoragePolicy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "access": {
      "$ref": "#/$defs/SourceAccessPolicy"
    },
    "copyright": {
      "$ref": "#/$defs/CopyrightPolicy"
    },
    "policy_version": {
      "maxLength": 50,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "review": {
      "$ref": "#/$defs/SourcePolicyReviewSubmission"
    },
    "robots_review": {
      "$ref": "#/$defs/ReviewEvidence"
    },
    "status": {
      "$ref": "#/$defs/SourcePolicyStatus"
    },
    "terms_review": {
      "$ref": "#/$defs/ReviewEvidence"
    }
  },
  "required": [
    "policy_version",
    "status",
    "robots_review",
    "terms_review",
    "copyright",
    "access",
    "review"
  ],
  "title": "SourcePolicySubmission",
  "type": "object"
}
