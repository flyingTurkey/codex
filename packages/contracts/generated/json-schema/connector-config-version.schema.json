{
  "$defs": {
    "ConnectorType": {
      "enum": [
        "RSS_ATOM",
        "JSON_API",
        "SITEMAP",
        "LIST_DETAIL",
        "DIRECT_PDF",
        "MANUAL_IMPORT"
      ],
      "title": "ConnectorType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_hosts": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Hosts",
      "type": "array"
    },
    "config": {
      "additionalProperties": true,
      "title": "Config",
      "type": "object"
    },
    "config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "connector_type": {
      "$ref": "#/$defs/ConnectorType"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "format": "uuid",
      "title": "Created By",
      "type": "string"
    },
    "credential_configured": {
      "title": "Credential Configured",
      "type": "boolean"
    },
    "definition_version": {
      "title": "Definition Version",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "policy_version_id": {
      "format": "uuid",
      "title": "Policy Version Id",
      "type": "string"
    },
    "source_id": {
      "format": "uuid",
      "title": "Source Id",
      "type": "string"
    },
    "validation_status": {
      "enum": [
        "VALID",
        "INVALID"
      ],
      "title": "Validation Status",
      "type": "string"
    },
    "version_number": {
      "minimum": 1,
      "title": "Version Number",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "source_id",
    "policy_version_id",
    "connector_type",
    "definition_version",
    "version_number",
    "config_sha256",
    "config",
    "allowed_hosts",
    "credential_configured",
    "validation_status",
    "created_by",
    "created_at"
  ],
  "title": "ConnectorConfigVersionView",
  "type": "object"
}
