{
  "additionalProperties": false,
  "properties": {
    "code": {
      "maxLength": 80,
      "pattern": "^[A-Z][A-Z0-9_]+$",
      "title": "Code",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ],
      "title": "Status",
      "type": "string"
    },
    "unit": {
      "enum": [
        "count",
        "percent",
        "ms",
        "seconds",
        "minutes",
        "microusd"
      ],
      "title": "Unit",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "code",
    "value",
    "unit",
    "status"
  ],
  "title": "MetricSample",
  "type": "object"
}
