{
  "$defs": {
    "Channel": {
      "enum": [
        "DIGITAL",
        "SAFETY"
      ],
      "title": "Channel",
      "type": "string"
    },
    "ClaimView": {
      "additionalProperties": false,
      "properties": {
        "claim_type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Claim Type",
          "type": "string"
        },
        "decision_status": {
          "anyOf": [
            {
              "enum": [
                "PENDING",
                "ACCEPTED",
                "REJECTED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Status"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "id",
        "claim_type",
        "label",
        "value",
        "evidence_ids"
      ],
      "title": "ClaimView",
      "type": "object"
    },
    "CriticalSafetyField": {
      "enum": [
        "DEATH_COUNT",
        "INJURY_COUNT",
        "LOSS_AMOUNT_MINOR",
        "OFFICIAL_DIRECT_CAUSES",
        "RESPONSIBILITY_FINDINGS"
      ],
      "title": "CriticalSafetyField",
      "type": "string"
    },
    "DocumentState": {
      "enum": [
        "UPDATED",
        "RE_REVIEW_PENDING",
        "WITHDRAWN",
        "SOURCE_UNAVAILABLE"
      ],
      "title": "DocumentState",
      "type": "string"
    },
    "EvidenceStatus": {
      "enum": [
        "WITHHELD",
        "VERIFIED"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "EvidenceView": {
      "additionalProperties": false,
      "properties": {
        "char_end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "claim_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        },
        "document_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Version Id"
        },
        "excerpt": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "excerpt_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Excerpt Sha256",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "HTML_PARAGRAPH": "#/$defs/HtmlParagraphLocator",
                  "PDF_OCR": "#/$defs/PdfOcrLocator",
                  "PDF_TABLE_CELL": "#/$defs/PdfTableCellLocator",
                  "PDF_TEXT": "#/$defs/PdfTextLocator"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/HtmlParagraphLocator"
                },
                {
                  "$ref": "#/$defs/PdfTextLocator"
                },
                {
                  "$ref": "#/$defs/PdfOcrLocator"
                },
                {
                  "$ref": "#/$defs/PdfTableCellLocator"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "original_url": {
          "maxLength": 2048,
          "pattern": "^https?://[^\\s]+$",
          "title": "Original Url",
          "type": "string"
        },
        "paragraph_id": {
          "anyOf": [
            {
              "pattern": "^html-p-\\d{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Id"
        }
      },
      "required": [
        "id",
        "claim_ids",
        "excerpt",
        "excerpt_sha256",
        "original_url"
      ],
      "title": "EvidenceView",
      "type": "object"
    },
    "FeedNotice": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "level": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Level",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "level",
        "message"
      ],
      "title": "FeedNotice",
      "type": "object"
    },
    "HtmlParagraphLocator": {
      "additionalProperties": false,
      "properties": {
        "char_end": {
          "exclusiveMinimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "paragraph_id": {
          "pattern": "^html-p-\\d{4}$",
          "title": "Paragraph Id",
          "type": "string"
        },
        "type": {
          "const": "HTML_PARAGRAPH",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "paragraph_id",
        "char_start",
        "char_end"
      ],
      "title": "HtmlParagraphLocator",
      "type": "object"
    },
    "IncidentStatus": {
      "enum": [
        "UNVERIFIED_LEAD",
        "INITIAL_OFFICIAL_REPORT",
        "UNDER_INVESTIGATION",
        "FINAL_INVESTIGATION_REPORT",
        "ENFORCEMENT_DECISION",
        "RECTIFICATION_FOLLOW_UP",
        "CLOSED",
        "CORRECTED",
        "WITHDRAWN"
      ],
      "title": "IncidentStatus",
      "type": "string"
    },
    "ItemSummary": {
      "additionalProperties": false,
      "properties": {
        "activity_at": {
          "format": "date-time",
          "title": "Activity At",
          "type": "string"
        },
        "content_type": {
          "$ref": "#/$defs/ItemType"
        },
        "detail_available": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail Available"
        },
        "document_states": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DocumentState"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document States"
        },
        "domain": {
          "$ref": "#/$defs/Channel"
        },
        "evidence_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Count"
        },
        "evidence_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "first_discovered_at": {
          "format": "date-time",
          "title": "First Discovered At",
          "type": "string"
        },
        "has_version_history": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Version History"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "is_saved": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Saved"
        },
        "last_updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Updated At"
        },
        "one_sentence_fact": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "One Sentence Fact"
        },
        "original_url": {
          "maxLength": 2048,
          "pattern": "^https?://[^\\s]+$",
          "title": "Original Url",
          "type": "string"
        },
        "publication_revision_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Publication Revision Id"
        },
        "publication_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicationStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "relevance_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relevance Reason"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "source_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Published At"
        },
        "source_role": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Role"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "type_summary": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "SAFETY_CASE": "#/$defs/SafetyCaseTypeSummary",
                  "SAFETY_REGULATION": "#/$defs/SafetyRegulationTypeSummary"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/SafetyRegulationTypeSummary"
                },
                {
                  "$ref": "#/$defs/SafetyCaseTypeSummary"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type Summary"
        }
      },
      "required": [
        "id",
        "publication_revision_id",
        "domain",
        "content_type",
        "title",
        "source_name",
        "source_published_at",
        "first_discovered_at",
        "activity_at",
        "original_url",
        "review_status"
      ],
      "title": "ItemSummary",
      "type": "object"
    },
    "ItemType": {
      "enum": [
        "DIGITAL_CASE",
        "JOURNAL_PAPER",
        "SOFTWARE_PRODUCT",
        "IOT_PRODUCT",
        "LOW_ALTITUDE_EQUIPMENT",
        "AI_EQUIPMENT",
        "SAFETY_REGULATION",
        "SAFETY_CASE"
      ],
      "title": "ItemType",
      "type": "string"
    },
    "PageBoundingBox": {
      "additionalProperties": false,
      "description": "Rotation-normalized PDF coordinates in integer thousandths of a point.",
      "properties": {
        "x0": {
          "minimum": 0,
          "title": "X0",
          "type": "integer"
        },
        "x1": {
          "exclusiveMinimum": 0,
          "title": "X1",
          "type": "integer"
        },
        "y0": {
          "minimum": 0,
          "title": "Y0",
          "type": "integer"
        },
        "y1": {
          "exclusiveMinimum": 0,
          "title": "Y1",
          "type": "integer"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "PageBoundingBox",
      "type": "object"
    },
    "PdfOcrLocator": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/PageBoundingBox"
        },
        "block_id": {
          "format": "uuid",
          "title": "Block Id",
          "type": "string"
        },
        "confidence_bps": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Confidence Bps",
          "type": "integer"
        },
        "page_number": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "type": {
          "const": "PDF_OCR",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "page_number",
        "block_id",
        "bbox",
        "type",
        "confidence_bps"
      ],
      "title": "PdfOcrLocator",
      "type": "object"
    },
    "PdfTableCellLocator": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/PageBoundingBox"
        },
        "column_index": {
          "minimum": 0,
          "title": "Column Index",
          "type": "integer"
        },
        "confidence_bps": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Bps"
        },
        "page_number": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "row_index": {
          "minimum": 0,
          "title": "Row Index",
          "type": "integer"
        },
        "table_cell_id": {
          "format": "uuid",
          "title": "Table Cell Id",
          "type": "string"
        },
        "type": {
          "const": "PDF_TABLE_CELL",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "page_number",
        "table_cell_id",
        "row_index",
        "column_index",
        "bbox"
      ],
      "title": "PdfTableCellLocator",
      "type": "object"
    },
    "PdfTextLocator": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/PageBoundingBox"
        },
        "block_id": {
          "format": "uuid",
          "title": "Block Id",
          "type": "string"
        },
        "page_number": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "type": {
          "const": "PDF_TEXT",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "page_number",
        "block_id",
        "bbox",
        "type"
      ],
      "title": "PdfTextLocator",
      "type": "object"
    },
    "PreventionMeasureTag": {
      "enum": [
        "HAZARD_IDENTIFICATION",
        "MONITORING_AND_EARLY_WARNING",
        "INSPECTION_AND_MAINTENANCE",
        "DESIGN_REVIEW",
        "CONSTRUCTION_QUALITY_CONTROL",
        "EMERGENCY_PREPAREDNESS",
        "TRAFFIC_OPERATION_RISK_CONTROL",
        "RESPONSIBILITY_AND_OVERSIGHT"
      ],
      "title": "PreventionMeasureTag",
      "type": "string"
    },
    "PublicationStatus": {
      "enum": [
        "PENDING_REVIEW",
        "PUBLISHED",
        "WITHDRAWN"
      ],
      "title": "PublicationStatus",
      "type": "string"
    },
    "RegulationClassification": {
      "enum": [
        "LAW",
        "ADMINISTRATIVE_REGULATION",
        "DEPARTMENT_RULE",
        "NORMATIVE_DOCUMENT",
        "STANDARD_OR_GUIDE"
      ],
      "title": "RegulationClassification",
      "type": "string"
    },
    "RegulationStatus": {
      "enum": [
        "DRAFT",
        "NOT_EFFECTIVE",
        "EFFECTIVE",
        "AMENDED",
        "REPEALED",
        "SUPERSEDED",
        "EXPIRED",
        "UNKNOWN"
      ],
      "title": "RegulationStatus",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SafetyCaseReportStage": {
      "enum": [
        "INITIAL_REPORT",
        "FOLLOW_UP_REPORT",
        "FINAL_INVESTIGATION",
        "ENFORCEMENT",
        "RECTIFICATION"
      ],
      "title": "SafetyCaseReportStage",
      "type": "string"
    },
    "SafetyCaseTypeSummary": {
      "additionalProperties": false,
      "description": "Reviewed safety-case projection; only ``kind`` is safe for an R3 stub.",
      "properties": {
        "conflicted_fields": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CriticalSafetyField"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflicted Fields"
        },
        "deaths": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deaths"
        },
        "engineering_type": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engineering Type"
        },
        "event_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "hazard_type": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hazard Type"
        },
        "incident_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/IncidentStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "injuries": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Injuries"
        },
        "kind": {
          "const": "SAFETY_CASE",
          "title": "Kind",
          "type": "string"
        },
        "loss_amount_minor": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loss Amount Minor"
        },
        "loss_currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loss Currency"
        },
        "occurred_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurred At"
        },
        "official_direct_causes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null means no formal investigation basis; an empty list means formal evidence was reviewed and stated no direct-cause finding",
          "title": "Official Direct Causes"
        },
        "prevention_measure_tags": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PreventionMeasureTag"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prevention Measure Tags"
        },
        "rectification_has_open_issues": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reviewed rectification evaluation result; null means not established",
          "title": "Rectification Has Open Issues"
        },
        "region": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "report_stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafetyCaseReportStage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "responsibility_findings": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null means no formal investigation or enforcement basis; an empty list means formal evidence was reviewed and stated no responsibility finding",
          "title": "Responsibility Findings"
        },
        "similar_scenario_tags": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SimilarScenarioTag"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similar Scenario Tags"
        }
      },
