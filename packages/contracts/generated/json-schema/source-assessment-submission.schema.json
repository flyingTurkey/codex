{
  "$defs": {
    "AuthorityLevel": {
      "enum": [
        "A0",
        "A1",
        "B1",
        "B2",
        "C1",
        "C2",
        "UNKNOWN"
      ],
      "title": "AuthorityLevel",
      "type": "string"
    },
    "SourceAuthorityAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessed_at": {
          "format": "date-time",
          "title": "Assessed At",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Evidence Refs",
          "type": "array"
        },
        "level": {
          "$ref": "#/$defs/AuthorityLevel"
        },
        "reason_codes": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "rule_version": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        }
      },
      "required": [
        "level",
        "rule_version",
        "reason_codes",
        "assessed_at"
      ],
      "title": "SourceAuthorityAssessment",
      "type": "object"
    },
    "SourceIndependenceAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessed_at": {
          "format": "date-time",
          "title": "Assessed At",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Evidence Refs",
          "type": "array"
        },
        "level": {
          "$ref": "#/$defs/SourceIndependenceLevel"
        },
        "reason_codes": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "rule_version": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        }
      },
      "required": [
        "level",
        "rule_version",
        "reason_codes",
        "assessed_at"
      ],
      "title": "SourceIndependenceAssessment",
      "type": "object"
    },
    "SourceIndependenceLevel": {
      "enum": [
        "EDITORIALLY_INDEPENDENT",
        "PARTIALLY_INDEPENDENT",
        "NOT_INDEPENDENT",
        "UNKNOWN"
      ],
      "title": "SourceIndependenceLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Append-only explainable authority and independence assessments.",
  "properties": {
    "authority": {
      "$ref": "#/$defs/SourceAuthorityAssessment"
    },
    "independence": {
      "$ref": "#/$defs/SourceIndependenceAssessment"
    },
    "reason": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "authority",
    "independence",
    "reason"
  ],
  "title": "SourceAssessmentSubmission",
  "type": "object"
}
