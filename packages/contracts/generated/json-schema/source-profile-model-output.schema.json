    },
    "industry_candidates": {
      "items": {
        "$ref": "#/$defs/SourceProfileCandidate"
      },
      "maxItems": 20,
      "title": "Industry Candidates",
      "type": "array"
    },
    "language_candidates": {
      "items": {
        "$ref": "#/$defs/SourceProfileCandidate"
      },
