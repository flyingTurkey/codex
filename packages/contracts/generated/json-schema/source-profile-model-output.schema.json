{
  "$defs": {
    "SourceProfileCandidate": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 100,
          "minimum": 0,
          "title": "Confidence",
          "type": "integer"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "reason_code": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Reason Code",
          "type": "string"
        },
        "value": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "confidence",
        "reason_code",
        "evidence_ids"
      ],
      "title": "SourceProfileCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Semantic clues only; authority and independence remain server-derived.",
  "properties": {
    "content_domain_candidates": {
