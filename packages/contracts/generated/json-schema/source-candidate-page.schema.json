{
  "$defs": {
    "DiscoveryChannel": {
      "enum": [
        "DIRECTORY",
        "RSS",
        "SITEMAP",
        "OUTBOUND_LINK",
        "MANUAL",
        "BAIDU_SEARCH"
      ],
      "title": "DiscoveryChannel",
      "type": "string"
    },
    "EvidenceCapturePolicy": {
      "description": "How qualification evidence may be captured, independent of display policy.",
      "enum": [
        "PRIVATE_RAW_ALLOWED",
        "TRANSIENT_METADATA_ONLY"
      ],
      "title": "EvidenceCapturePolicy",
      "type": "string"
    },
    "QualificationBundleView": {
      "additionalProperties": false,
      "properties": {
        "bundle_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Bundle Sha256",
          "type": "string"
        },
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/QualificationCheckView"
          },
          "maxItems": 100,
          "title": "Checks",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence_capture_policy": {
          "$ref": "#/$defs/EvidenceCapturePolicy",
          "default": "PRIVATE_RAW_ALLOWED"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "material_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Material Fingerprint",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Reason Codes",
          "type": "array"
        },
        "relevant_item_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Relevant Item Count",
          "type": "integer"
        },
        "rule_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "sampled_item_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Sampled Item Count",
          "type": "integer"
        },
        "storage_policy": {
          "$ref": "#/$defs/StoragePolicy"
        },
        "verdict": {
          "$ref": "#/$defs/QualificationVerdict"
        }
      },
      "required": [
        "id",
        "candidate_id",
        "run_id",
        "rule_version",
        "material_fingerprint",
        "verdict",
        "storage_policy",
        "sampled_item_count",
        "relevant_item_count",
        "bundle_sha256",
        "created_at",
        "expires_at"
      ],
      "title": "QualificationBundleView",
      "type": "object"
    },
    "QualificationCheckLevel": {
      "enum": [
        "PASS",
        "WARN",
        "BLOCK"
      ],
      "title": "QualificationCheckLevel",
      "type": "string"
    },
    "QualificationCheckView": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Evidence Refs",
          "type": "array"
        },
        "level": {
          "$ref": "#/$defs/QualificationCheckLevel"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "code",
        "level",
        "message",
        "observed_at"
      ],
      "title": "QualificationCheckView",
      "type": "object"
    },
    "QualificationVerdict": {
      "enum": [
        "QUALIFIED",
        "WARN_WAIVABLE",
        "BLOCKED"
      ],
      "title": "QualificationVerdict",
      "type": "string"
    },
    "SourceCandidateAction": {
      "enum": [
        "REQUEST_QUALIFICATION",
        "ENABLE",
        "DISMISS"
      ],
      "title": "SourceCandidateAction",
      "type": "string"
    },
    "SourceCandidateStatus": {
      "enum": [
        "DISCOVERED",
        "QUALIFYING",
        "READY_FOR_DECISION",
        "ENABLED",
        "DISMISSED",
        "BLOCKED",
        "STALE"
      ],
      "title": "SourceCandidateStatus",
      "type": "string"
    },
    "SourceCandidateSummary": {
      "additionalProperties": false,
      "properties": {
        "authorization_boundary": {
          "title": "Authorization Boundary",
          "type": "string"
        },
        "available_actions": {
          "items": {
            "$ref": "#/$defs/SourceCandidateAction"
          },
          "title": "Available Actions",
          "type": "array"
        },
        "batch_enable_eligible": {
          "default": false,
          "title": "Batch Enable Eligible",
          "type": "boolean"
        },
        "canonical_url": {
          "title": "Canonical Url",
          "type": "string"
        },
        "content_domains": {
          "items": {
            "$ref": "#/$defs/SourceContentDomain"
          },
          "title": "Content Domains",
          "type": "array"
        },
        "discovery_channels": {
          "items": {
            "$ref": "#/$defs/DiscoveryChannel"
          },
          "title": "Discovery Channels",
          "type": "array"
        },
        "first_discovered_at": {
          "format": "date-time",
          "title": "First Discovered At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "industries": {
          "items": {
            "$ref": "#/$defs/SourceIndustry"
          },
          "title": "Industries",
          "type": "array"
        },
        "institution_name": {
          "title": "Institution Name",
          "type": "string"
        },
        "language_tags": {
          "items": {
            "maxLength": 35,
            "minLength": 2,
            "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
            "type": "string"
          },
          "title": "Language Tags",
          "type": "array"
        },
        "last_discovered_at": {
          "format": "date-time",
          "title": "Last Discovered At",
          "type": "string"
        },
        "latest_qualification": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualificationBundleView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "occurrence_count": {
          "minimum": 1,
          "title": "Occurrence Count",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/SourceCandidateStatus"
        }
      },
      "required": [
        "id",
        "institution_name",
        "canonical_url",
        "authorization_boundary",
        "discovery_channels",
        "status",
        "occurrence_count",
        "first_discovered_at",
        "last_discovered_at"
      ],
      "title": "SourceCandidateSummary",
      "type": "object"
    },
    "SourceContentDomain": {
      "enum": [
        "DIGITAL_TRANSFORMATION_CASE",
        "RESEARCH_PAPER",
        "SOFTWARE_PLATFORM",
        "IOT_EQUIPMENT",
        "LOW_ALTITUDE_EQUIPMENT",
        "AI_APPLICATION",
        "SAFETY_REGULATION",
        "STANDARD_GUIDANCE",
        "ACCIDENT_INVESTIGATION",
        "OFFICIAL_NOTICE",
        "PENALTY",
        "RECTIFICATION",
        "UNKNOWN"
      ],
      "title": "SourceContentDomain",
      "type": "string"
    },
    "SourceIndustry": {
      "enum": [
        "HIGHWAY",
        "BRIDGE",
        "TUNNEL",
        "RAILWAY",
        "RAIL_TRANSIT",
        "WATER_CONSERVANCY",
        "MUNICIPAL",
        "BUILDING",
        "ENERGY",
        "PORT_WATERWAY",
        "AIRPORT",
        "GENERAL_TRANSPORT",
        "UNKNOWN"
      ],
      "title": "SourceIndustry",
      "type": "string"
    },
    "StoragePolicy": {
      "enum": [
        "RAW_EVIDENCE_ALLOWED",
        "METADATA_ONLY",
        "LINK_ONLY"
      ],
      "title": "StoragePolicy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "has_more": {
      "title": "Has More",
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SourceCandidateSummary"
      },
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "status_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "#/$defs/SourceCandidateStatus"
      },
      "title": "Status Counts",
      "type": "object"
    }
  },
  "required": [
    "items",
    "has_more"
  ],
  "title": "SourceCandidatePage",
  "type": "object"
}
