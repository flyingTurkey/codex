{
  "$defs": {
    "OperatorWorkCategory": {
      "enum": [
        "SOURCE_MAINTENANCE",
        "EXCEPTION_HANDLING",
        "R3_REVIEW",
        "COPYRIGHT_CORRECTION"
      ],
      "title": "OperatorWorkCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_seconds": {
      "anyOf": [
        {
          "maximum": 43200,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Seconds"
    },
    "actor_id": {
      "format": "uuid",
      "title": "Actor Id",
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/OperatorWorkCategory"
    },
    "corrected": {
      "default": false,
      "title": "Corrected",
      "type": "boolean"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "last_activity_at": {
      "format": "date-time",
      "title": "Last Activity At",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "stopped_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stopped At"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "window_id": {
      "format": "uuid",
      "title": "Window Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "task_id",
    "window_id",
    "actor_id",
    "category",
    "started_at",
    "last_activity_at"
  ],
  "title": "OperatorWorkSessionView",
  "type": "object"
}
