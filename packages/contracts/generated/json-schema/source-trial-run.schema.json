{
  "$defs": {
    "SourceTrialKind": {
      "enum": [
        "FIXTURE_REPLAY",
        "LIVE_TRIAL"
      ],
      "title": "SourceTrialKind",
      "type": "string"
    },
    "SourceTrialQualitySummary": {
      "additionalProperties": false,
      "properties": {
        "parse_failed_count": {
          "minimum": 0,
          "title": "Parse Failed Count",
          "type": "integer"
        },
        "raw_count": {
          "minimum": 0,
          "title": "Raw Count",
          "type": "integer"
        },
        "ready_count": {
          "minimum": 0,
          "title": "Ready Count",
          "type": "integer"
        },
        "ready_ratio_bps": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Ready Ratio Bps",
          "type": "integer"
        },
        "rejected_raw_attempt_count": {
          "minimum": 0,
          "title": "Rejected Raw Attempt Count",
          "type": "integer"
        },
        "security_failed_count": {
          "minimum": 0,
          "title": "Security Failed Count",
          "type": "integer"
        }
      },
      "required": [
        "raw_count",
        "ready_count",
        "parse_failed_count",
        "security_failed_count",
        "rejected_raw_attempt_count",
        "ready_ratio_bps"
      ],
      "title": "SourceTrialQualitySummary",
      "type": "object"
    },
    "SourceTrialRunStatus": {
      "enum": [
        "PENDING",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "SourceTrialRunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "connector_config_version_id": {
      "format": "uuid",
      "title": "Connector Config Version Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/SourceTrialKind"
    },
    "policy_version_id": {
      "format": "uuid",
      "title": "Policy Version Id",
      "type": "string"
    },
    "quality_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceTrialQualitySummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "requested_by": {
      "format": "uuid",
      "title": "Requested By",
      "type": "string"
    },
    "source_id": {
      "format": "uuid",
      "title": "Source Id",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/SourceTrialRunStatus"
    }
  },
  "required": [
    "id",
    "source_id",
    "kind",
    "status",
    "policy_version_id",
    "connector_config_version_id",
    "requested_by",
    "created_at"
  ],
  "title": "SourceTrialRunView",
  "type": "object"
}
