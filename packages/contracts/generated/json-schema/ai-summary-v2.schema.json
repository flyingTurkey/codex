  "additionalProperties": false,
  "properties": {
    "body": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 30,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Body"
    },
    "claim_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Claim Ids",
      "type": "array"
    },
    "generated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generated At"
    },
    "judgment_paragraphs": {
      "items": {
        "type": "integer"
      },
      "maxItems": 3,
      "title": "Judgment Paragraphs",
      "type": "array"
    },
    "model": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "paragraphs": {
      "items": {
        "discriminator": {
          "mapping": {
            "FACT": "#/$defs/AiSummaryFactParagraphV2",
            "JUDGMENT": "#/$defs/AiSummaryJudgmentParagraphV2"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/AiSummaryFactParagraphV2"
          },
          {
            "$ref": "#/$defs/AiSummaryJudgmentParagraphV2"
          }
