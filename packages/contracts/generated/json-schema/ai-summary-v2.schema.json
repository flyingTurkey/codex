          "title": "Judgment Type",
          "type": "string"
        },
        "kind": {
          "const": "JUDGMENT",
          "default": "JUDGMENT",
          "title": "Kind",
          "type": "string"
        },
        "section": {
          "enum": [
            "ENGINEERING_IMPACT",
            "LIMITATIONS_AND_FOLLOW_UP"
          ],
          "title": "Section",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "section",
        "text",
        "judgment_type"
      ],
      "title": "AiSummaryJudgmentParagraphV2",
      "type": "object"
    },
    "AiSummaryStatusV2": {
      "enum": [
        "NOT_GENERATED",
        "PROCESSING",
        "TEMPORARILY_UNAVAILABLE",
        "SCHEMA_REJECTED",
        "INSUFFICIENT_EVIDENCE",
        "SUCCEEDED",
        "STALE"
