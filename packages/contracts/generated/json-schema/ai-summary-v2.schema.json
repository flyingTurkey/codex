{
  "$defs": {
    "AiSummaryFactParagraphV2": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        },
        "judgment_type": {
          "default": null,
          "title": "Judgment Type",
          "type": "null"
        },
        "kind": {
          "const": "FACT",
          "default": "FACT",
          "title": "Kind",
          "type": "string"
        },
        "section": {
          "const": "WHAT_HAPPENED",
          "title": "Section",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "section",
        "text",
        "claim_ids"
      ],
      "title": "AiSummaryFactParagraphV2",
      "type": "object"
    },
    "AiSummaryJudgmentParagraphV2": {
      "additionalProperties": false,
      "properties": {
