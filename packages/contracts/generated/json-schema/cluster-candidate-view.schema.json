{
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "feature_explanations": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Feature Explanations",
      "type": "array"
    },
    "hard_conflicts": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Hard Conflicts",
      "type": "array"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "DUPLICATE",
        "EVENT",
        "TOPIC",
        "RELATION"
      ],
      "title": "Kind",
      "type": "string"
    },
    "member_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 2,
      "title": "Member Ids",
      "type": "array"
    },
    "relation_type": {
      "anyOf": [
        {
          "maxLength": 50,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relation Type"
    },
    "score_bps": {
      "anyOf": [
        {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score Bps"
    },
    "status": {
      "enum": [
        "PENDING_REVIEW",
        "ACCEPTED",
        "REJECTED"
      ],
      "title": "Status",
      "type": "string"
