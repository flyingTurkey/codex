{
  "$defs": {
    "PersonalSourceInputKind": {
      "enum": [
        "HOMEPAGE",
        "LIST_PAGE",
        "RSS_ATOM",
        "SITEMAP",
        "JSON_API",
        "DIRECT_PDF",
        "UNKNOWN"
      ],
      "title": "PersonalSourceInputKind",
      "type": "string"
    },
    "PersonalSourceProbeStatus": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "PersonalSourceProbeStatus",
      "type": "string"
    },
    "PersonalSourceRuntimeState": {
      "description": "Observed personal-source runtime state, independent from owner intent.",
      "enum": [
        "PENDING_CONFIGURATION",
        "STOPPED",
        "RUNNING",
        "ERROR"
      ],
      "title": "PersonalSourceRuntimeState",
      "type": "string"
    },
    "PersonalSourceStreamStatus": {
      "enum": [
        "PROBING",
        "READY",
        "PROBE_FAILED"
      ],
      "title": "PersonalSourceStreamStatus",
      "type": "string"
    },
    "PersonalSourceStreamType": {
      "enum": [
        "UNKNOWN",
        "RSS_ATOM",
        "SITEMAP",
        "JSON_API",
        "DIRECT_PDF",
        "LIST_DETAIL"
      ],
      "title": "PersonalSourceStreamType",
      "type": "string"
    },
    "PersonalSourceStreamView": {
      "additionalProperties": false,
      "properties": {
        "actual_running": {
          "default": false,
          "title": "Actual Running",
          "type": "boolean"
        },
        "allowed_hosts": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Allowed Hosts",
          "type": "array"
        },
        "config_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Sha256"
        },
        "consecutive_failures": {
          "default": 0,
          "minimum": 0,
          "title": "Consecutive Failures",
          "type": "integer"
        },
        "discovery_method": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Discovery Method",
          "type": "string"
        },
        "failure_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason"
        },
        "health_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/PersonalStreamHealthReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "health_status": {
          "$ref": "#/$defs/PersonalStreamHealthStatus",
          "default": "UNKNOWN"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "last_content_discovered_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Content Discovered At"
        },
        "last_successful_fetch_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Successful Fetch At"
        },
        "next_self_heal_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Self Heal At"
        },
        "normalized_url": {
          "maxLength": 2048,
          "pattern": "^https://[^\\s]+$",
          "title": "Normalized Url",
          "type": "string"
        },
        "runtime_state": {
          "$ref": "#/$defs/PersonalStreamRuntimeState",
          "default": "STOPPED"
        },
        "status": {
          "$ref": "#/$defs/PersonalSourceStreamStatus"
        },
        "stream_type": {
          "$ref": "#/$defs/PersonalSourceStreamType"
        }
      },
      "required": [
        "id",
        "stream_type",
        "normalized_url",
        "allowed_hosts",
        "discovery_method",
        "status"
      ],
      "title": "PersonalSourceStreamView",
      "type": "object"
    },
    "PersonalStreamHealthReason": {
      "enum": [
        "DNS_FAILURE",
        "TLS_FAILURE",
        "TIMEOUT",
        "HTTP_401",
        "HTTP_403",
        "HTTP_404",
        "HTTP_429",
        "HTTP_5XX",
        "ROBOTS_BLOCKED",
        "LOGIN_REQUIRED",
        "CAPTCHA_DETECTED",
        "PAYWALL_DETECTED",
        "MIME_MISMATCH",
        "PARSE_FAILED",
        "ZERO_DISCOVERY_STREAK",
        "STRUCTURE_CHANGED",
        "REQUIRED_FIELDS_MISSING",
        "CONTENT_STALE",
        "BUDGET_EXHAUSTED",
        "CIRCUIT_OPEN"
      ],
      "title": "PersonalStreamHealthReason",
      "type": "string"
    },
    "PersonalStreamHealthStatus": {
      "enum": [
        "UNKNOWN",
        "HEALTHY",
        "DEGRADED",
        "UNHEALTHY"
      ],
      "title": "PersonalStreamHealthStatus",
      "type": "string"
    },
    "PersonalStreamRuntimeState": {
      "enum": [
        "STOPPED",
        "SCHEDULED",
        "CIRCUIT_OPEN",
        "HALF_OPEN",
        "BUDGET_EXHAUSTED",
        "INACCESSIBLE"
      ],
      "title": "PersonalStreamRuntimeState",
      "type": "string"
    },
    "SourceProfileStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL"
      ],
      "title": "SourceProfileStatus",
      "type": "string"
    },
    "SourceProfileSummaryView": {
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "overall_confidence": {
          "maximum": 100,
          "minimum": 0,
          "title": "Overall Confidence",
          "type": "integer"
        },
        "overridden_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Overridden Fields",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/SourceProfileStatus"
        }
      },
      "required": [
        "status",
        "overall_confidence",
        "generated_at"
      ],
      "title": "SourceProfileSummaryView",
      "type": "object"
    },
    "StreamProbeRunView": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "failure_code": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "failure_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "input_kind": {
          "$ref": "#/$defs/PersonalSourceInputKind"
        },
        "requested_url": {
          "maxLength": 2048,
          "pattern": "^https://[^\\s]+$",
          "title": "Requested Url",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PersonalSourceProbeStatus"
        }
      },
      "required": [
        "id",
        "requested_url",
        "input_kind",
        "status"
      ],
      "title": "StreamProbeRunView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "desired_enabled": {
      "title": "Desired Enabled",
      "type": "boolean"
    },
    "display_name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "latest_probe_run": {
      "anyOf": [
        {
          "$ref": "#/$defs/StreamProbeRunView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "manual_disabled_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manual Disabled At"
    },
    "normalized_origin": {
      "anyOf": [
        {
          "maxLength": 2048,
          "pattern": "^https://[^\\s]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Normalized Origin"
    },
    "profile_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceProfileSummaryView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime_state": {
      "$ref": "#/$defs/PersonalSourceRuntimeState"
    },
    "streams": {
      "items": {
        "$ref": "#/$defs/PersonalSourceStreamView"
      },
      "title": "Streams",
      "type": "array"
    },
    "url": {
      "maxLength": 2048,
      "pattern": "^https?://[^\\s]+$",
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "id",
    "display_name",
    "url",
    "desired_enabled",
    "runtime_state"
  ],
  "title": "PersonalSourceView",
  "type": "object"
}
