{
  "$defs": {
    "AutomaticPublicationPolicy": {
      "enum": [
        "DISABLED",
        "PUBLICATION_GATE_ELIGIBLE"
      ],
      "title": "AutomaticPublicationPolicy",
      "type": "string"
    },
    "DisplayPolicy": {
      "enum": [
        "METADATA_EXCERPT_LINK",
        "OFFICIAL_READER_LINK",
        "LINK_ONLY"
      ],
      "title": "DisplayPolicy",
      "type": "string"
    },
    "DownloadPolicy": {
      "enum": [
        "DISABLED",
        "ORIGINAL_LINK_ONLY",
        "SIGNED_INTERNAL_COPY"
      ],
      "title": "DownloadPolicy",
      "type": "string"
    },
    "LegalHoldPolicy": {
      "enum": [
        "SUPPORTED",
        "NOT_APPLICABLE"
      ],
      "title": "LegalHoldPolicy",
      "type": "string"
    },
    "ReviewEvidence": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Sha256"
        },
        "evidence_url": {
          "maxLength": 2048,
          "pattern": "^https?://[^\\s]+$",
          "title": "Evidence Url",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/ReviewEvidenceResult"
        }
      },
      "required": [
        "result",
        "evidence_url",
        "checked_at"
      ],
      "title": "ReviewEvidence",
      "type": "object"
    },
    "ReviewEvidenceResult": {
      "enum": [
        "ALLOWED",
        "RESTRICTED",
        "NOT_PRESENT",
        "BLOCKED"
      ],
      "title": "ReviewEvidenceResult",
      "type": "string"
    },
    "SloApplicability": {
      "enum": [
        "APPLICABLE",
        "NOT_APPLICABLE"
      ],
      "title": "SloApplicability",
      "type": "string"
    },
    "SourceFetchPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_domains": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Allowed Domains",
          "type": "array"
        },
        "minimum_interval_seconds": {
          "maximum": 604800,
          "minimum": 1,
          "title": "Minimum Interval Seconds",
          "type": "integer"
        },
        "rate_limit_per_minute": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Rate Limit Per Minute",
          "type": "integer"
        },
        "user_agent": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "User Agent",
          "type": "string"
        }
      },
      "required": [
        "allowed_domains",
        "minimum_interval_seconds",
        "rate_limit_per_minute",
        "user_agent"
      ],
      "title": "SourceFetchPolicy",
      "type": "object"
    },
    "SourceRetentionPolicy": {
      "additionalProperties": false,
      "properties": {
        "delete_after_retention": {
          "title": "Delete After Retention",
          "type": "boolean"
        },
        "retention_days": {
          "maximum": 36500,
          "minimum": 1,
          "title": "Retention Days",
          "type": "integer"
        }
      },
      "required": [
        "retention_days",
        "delete_after_retention"
      ],
      "title": "SourceRetentionPolicy",
      "type": "object"
    },
    "SourceSloPolicy": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/SloApplicability"
        },
        "authorization_confirmed": {
          "title": "Authorization Confirmed",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "target_minutes": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Minutes"
        },
        "technical_conditions_confirmed": {
          "title": "Technical Conditions Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "applicability",
        "authorization_confirmed",
        "technical_conditions_confirmed"
      ],
      "title": "SourceSloPolicy",
      "type": "object"
    },
    "StoragePolicy": {
      "enum": [
        "RAW_EVIDENCE_ALLOWED",
        "METADATA_ONLY",
        "LINK_ONLY"
      ],
      "title": "StoragePolicy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Declarative policy input; status and approval are server-owned facts.",
  "properties": {
    "automatic_publication": {
      "$ref": "#/$defs/AutomaticPublicationPolicy"
    },
    "copyright_review": {
      "$ref": "#/$defs/ReviewEvidence"
    },
    "display_policy": {
      "$ref": "#/$defs/DisplayPolicy"
    },
    "download_policy": {
      "$ref": "#/$defs/DownloadPolicy"
    },
    "fetch": {
      "$ref": "#/$defs/SourceFetchPolicy"
    },
    "legal_hold_policy": {
      "$ref": "#/$defs/LegalHoldPolicy"
    },
    "policy_version": {
      "maxLength": 50,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "reason": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "retention": {
      "$ref": "#/$defs/SourceRetentionPolicy"
    },
    "robots_review": {
      "$ref": "#/$defs/ReviewEvidence"
    },
    "schema_version": {
      "const": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "slo": {
      "$ref": "#/$defs/SourceSloPolicy"
    },
    "storage_policy": {
      "$ref": "#/$defs/StoragePolicy"
    },
    "terms_review": {
      "$ref": "#/$defs/ReviewEvidence"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "format": "date-time",
      "title": "Valid Until",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "policy_version",
    "valid_from",
    "valid_until",
    "robots_review",
    "terms_review",
    "copyright_review",
    "fetch",
    "storage_policy",
    "display_policy",
    "download_policy",
    "retention",
    "legal_hold_policy",
    "automatic_publication",
    "slo",
    "reason"
  ],
  "title": "SourcePolicyV2Submission",
  "type": "object"
}
