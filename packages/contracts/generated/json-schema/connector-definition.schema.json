{
  "$defs": {
    "ConnectorType": {
      "enum": [
        "RSS_ATOM",
        "JSON_API",
        "SITEMAP",
        "LIST_DETAIL",
        "DIRECT_PDF",
        "MANUAL_IMPORT"
      ],
      "title": "ConnectorType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "connector_type": {
      "$ref": "#/$defs/ConnectorType"
    },
    "definition_version": {
      "title": "Definition Version",
      "type": "string"
    },
    "executor_key": {
      "title": "Executor Key",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "schema_document": {
      "additionalProperties": true,
      "title": "Schema Document",
      "type": "object"
    },
    "schema_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Schema Sha256",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "connector_type",
    "definition_version",
    "schema_version",
    "schema_document",
    "schema_sha256",
    "executor_key",
    "capabilities"
