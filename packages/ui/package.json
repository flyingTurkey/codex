{
  "name": "@srbg/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./theme.css": "./src/generated/theme.css"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check"
  },
  "dependencies": {
    "iconoir-vue": "7.11.0"
  },
  "peerDependencies": {
    "@srbg/contracts": "workspace:*",
    "vue": "3.5.39"
  },
  "devDependencies": {
    "@srbg/contracts": "workspace:*",
    "@types/node": "26.1.1",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.7.0",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.7.0",
    "happy-dom": "20.10.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vue": "3.5.39",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.7"
  }
}
