{
  "categories": {
    "documentation": [
      "*.md",
      "docs/**"
    ],
    "tooling": [
      "scripts/ci/**",
      "tests/infrastructure/test_risk_matrix.py",
      "tests/infrastructure/test_pytest_partitions.py",
      "tests/infrastructure/test_migration_gate.py"
    ],
    "orchestration": [
