      "apps/api/src/srbg_api/document_vault/**",
      "apps/api/src/srbg_api/event_unification/**",
      "apps/api/src/srbg_api/intelligence_resolution/**",
      "apps/api/src/srbg_api/papers/**",
      "apps/api/src/srbg_api/pdf_processing/**",
      "apps/api/src/srbg_api/safety_regulations/**",
      "apps/api/src/srbg_api/technology_products/**",
      "apps/api/src/srbg_api/intelligence_v2/content_candidate*.py",
      "apps/worker/src/srbg_worker/source_content_bridge.py"
    ],
    "ai": [
      "apps/api/src/srbg_api/ai_admin/**",
      "apps/api/src/srbg_api/ai_pipeline/**",
