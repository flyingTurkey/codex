{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intelligence v2 qualification prediction for Owner Gold calibration",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "content_sha256", "input_sha256", "corpus_version", "rule_version", "model_id", "prompt_version", "schema_version", "predicted_at", "predicted_relevant", "primary_type", "confidence_bps"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "corpus_version": {"enum": ["owner-gold-2026-07-20.4", "owner-gold-2026-07-20.5"]},
    "rule_version": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "schema_version": {"const": "intelligence-v2-owner-gold-2.0.0"},
    "predicted_at": {"type": "string", "format": "date-time"},
    "predicted_relevant": {"type": "boolean"},
    "primary_type": {
      "type": ["string", "null"],
      "enum": ["DIGITAL_TRANSFORMATION", "SAFETY_INTELLIGENCE", "INDUSTRY_UPDATE", null]
    },
    "confidence_bps": {"type": "integer", "minimum": 0, "maximum": 10000}
  }
}
