{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srbg.example.internal/schemas/readiness-evidence-1.1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "baseline_commit", "branch", "workspace_snapshot_sha256", "environment", "window", "claims", "decision", "generated_by_ci", "manifest_sha256"],
  "properties": {
    "manifest_version": {"const": "1.1.0"},
    "baseline_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "branch": {"type": "string", "minLength": 1},
    "workspace_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "environment": {"enum": ["TEST", "PREPRODUCTION", "PRODUCTION"]},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "started_at", "ended_at", "duration_days"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "duration_days": {"type": "number", "minimum": 0}
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "status", "executed_at", "executed_by", "policy", "gold_set", "evidence_refs"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "status": {"enum": ["PASSED", "FAILED", "INSUFFICIENT_EVIDENCE"]},
          "executed_at": {"type": "string", "format": "date-time"},
          "executed_by": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {"kind": {"enum": ["AGENT", "CI", "HUMAN"]}, "id": {"type": "string", "minLength": 1}}
          },
          "policy": {"$ref": "#/$defs/versionedHash"},
          "gold_set": {"$ref": "#/$defs/versionedHash"},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/evidenceRef"}
          }
        }
      }
    },
    "decision": {"enum": ["BLOCKED", "INTERNAL_PILOT_READY", "READY_FOR_INDEPENDENT_ACCEPTANCE"]},
    "generated_by_ci": {"type": "boolean"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "versionedHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri", "sha256", "baseline_commit", "environment", "window_id"],
      "properties": {
        "kind": {"enum": ["TEST_LOG", "MONITOR_QUERY", "DRILL_RECORD", "REPORT", "CONFIG"]},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "baseline_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "environment": {"enum": ["TEST", "PREPRODUCTION", "PRODUCTION"]},
        "window_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"}
      }
    }
  }
}
