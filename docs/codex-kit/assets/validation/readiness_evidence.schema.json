{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srbg.example.internal/schemas/readiness-evidence-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "environment", "window", "policy", "gold_set", "metrics", "test_runs", "recovery_exercise", "decision", "generated_by_ci", "manifest_sha256"],
  "properties": {
    "manifest_version": {"const": "1.0.0"},
    "environment": {"enum": ["TEST", "PREPRODUCTION", "PRODUCTION"]},
    "window": {
      "type": "object",
      "required": ["started_at", "ended_at", "duration_days"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "duration_days": {"type": "number", "minimum": 0}
      }
    },
    "policy": {
      "type": "object",
      "required": ["version", "sha256", "repository_commit"],
      "properties": {
        "version": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "repository_commit": {"type": "string"}
      }
    },
    "gold_set": {
      "type": "object",
      "required": ["version", "sha256", "document_count", "duplicate_pair_count", "event_cluster_count", "claim_evidence_count", "search_question_count"],
      "properties": {
        "version": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "document_count": {"type": "integer", "minimum": 500},
        "duplicate_pair_count": {"type": "integer", "minimum": 300},
        "event_cluster_count": {"type": "integer", "minimum": 100},
        "claim_evidence_count": {"type": "integer", "minimum": 200},
        "search_question_count": {"type": "integer", "minimum": 100}
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "numerator", "denominator", "value", "threshold", "operator", "source_query_ref", "passed"],
        "properties": {
          "code": {"type": "string"},
          "numerator": {"type": "number"},
          "denominator": {"type": "number", "exclusiveMinimum": 0},
          "value": {"type": "number"},
          "threshold": {"type": "number"},
          "operator": {"enum": ["GTE", "LTE", "EQ"]},
          "source_query_ref": {"type": "string"},
          "passed": {"type": "boolean"}
        }
      }
    },
    "test_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "commit", "log_sha256", "passed"],
        "properties": {
          "name": {"type": "string"},
          "commit": {"type": "string"},
          "log_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "passed": {"const": true}
        }
      }
    },
    "recovery_exercise": {
      "type": "object",
      "required": ["performed_at", "rpo_minutes", "rto_minutes", "evidence_sha256", "passed"],
      "properties": {
        "performed_at": {"type": "string", "format": "date-time"},
        "rpo_minutes": {"type": "number", "maximum": 15},
        "rto_minutes": {"type": "number", "maximum": 240},
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "passed": {"const": true}
      }
    },
    "decision": {"enum": ["BLOCKED", "INTERNAL_PILOT_READY", "PRODUCTION_READY"]},
    "generated_by_ci": {"const": true},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

