{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srbg.example.internal/schemas/summarize-output-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["one_sentence", "why_it_matters", "key_points", "applicable_scenarios", "limitations", "recommended_actions", "used_claim_ids"],
  "properties": {
    "one_sentence": {"type": "string", "minLength": 1, "maxLength": 160},
    "why_it_matters": {"type": "string", "minLength": 1, "maxLength": 240},
    "key_points": {"type": "array", "maxItems": 5, "items": {"type": "string"}},
    "applicable_scenarios": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "recommended_actions": {"type": "array", "items": {"enum": ["READ_ORIGINAL", "PROFESSIONAL_REVIEW", "SAVE", "FOLLOW", "TECHNICAL_RESEARCH"]}},
    "used_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}

