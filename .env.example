# DEVELOPMENT-ONLY values for the local Compose stack. Never reuse in production.
SRBG_DATA_ROOT=/mnt/host/wsl/SRBGDataDisk/srv
POSTGRES_DB=srbg
POSTGRES_USER=srbg
POSTGRES_PASSWORD=srbg_local_only
SRBG_API_DB_PASSWORD=srbg_api_local_only
SRBG_WORKER_DB_PASSWORD=srbg_worker_local_only
SRBG_PUBLISHER_DB_PASSWORD=srbg_publisher_local_only
SRBG_PROJECTION_DB_PASSWORD=srbg_projection_local_only
MINIO_ROOT_USER=srbg_local
MINIO_ROOT_PASSWORD=srbg_local_storage_only
ANCHOR_MINIO_PORT=9002
ANCHOR_MINIO_ROOT_USER=srbg_anchor_local
ANCHOR_MINIO_ROOT_PASSWORD=srbg_anchor_storage_only
SRBG_BACKUP_S3_ENDPOINT_URL=http://anchor-minio:9000
SRBG_BACKUP_S3_BUCKET=srbg-audit-anchors
SRBG_BACKUP_S3_ACCESS_KEY=srbg_anchor_local
SRBG_BACKUP_S3_SECRET_KEY=srbg_anchor_storage_only

# Application configuration. All external I/O is bounded by this timeout.
SRBG_ENVIRONMENT=demo
# The local proxy always injects the single personal product role.
NUXT_LOCAL_APP_ROLES=owner
SRBG_DATABASE_URL=postgresql+asyncpg://srbg_api_login:srbg_api_local_only@postgres:5432/srbg
SRBG_PUBLICATION_DATABASE_URL=postgresql+asyncpg://srbg_publisher_login:srbg_publisher_local_only@postgres:5432/srbg
SRBG_REDIS_URL=redis://redis:6379/0
# Keep the primary Celery worker small on a personal Docker Desktop runtime.
SRBG_WORKER_CONCURRENCY=1
# Bound local container logs; increase only when a longer debugging window is needed.
SRBG_DOCKER_LOG_MAX_SIZE=10m
SRBG_DOCKER_LOG_MAX_FILES=3
SRBG_PROMETHEUS_RETENTION_TIME=15d
SRBG_PROMETHEUS_RETENTION_SIZE=2GB
SRBG_S3_ENDPOINT_URL=http://minio:9000
SRBG_S3_ACCESS_KEY=srbg_local
SRBG_S3_SECRET_KEY=srbg_local_storage_only
SRBG_S3_BUCKET=srbg-raw
SRBG_S3_REGION=us-east-1
SRBG_CLAMAV_HOST=clamav
SRBG_CLAMAV_PORT=3310
SRBG_FIXTURE_MAX_BYTES=52428800
SRBG_FIXTURE_MAX_PDF_PAGES=1000
SRBG_EXTERNAL_IO_TIMEOUT_SECONDS=2
SRBG_OPENALEX_API_KEY=
SRBG_ACADEMIC_CONTACT=data-platform@srbg.local
# Optional candidate recall only; final recommendations always pass the same hard constraints.
SRBG_PGVECTOR_RECALL_ENABLED=false
SRBG_CURSOR_SIGNING_KEY=replace-with-at-least-32-random-bytes
SRBG_SEMANTIC_SEARCH_ENABLED=false
SRBG_SEMANTIC_SEARCH_TIMEOUT_SECONDS=0.3
# Automated source discovery remains fail-closed until all three flags and the secret are set.
# Provider-authored titles/snippets/queries are transient and must never enter logs or storage.
SRBG_SOURCE_DISCOVERY_ENABLED=false
SRBG_BAIDU_SEARCH_ENABLED=false
SRBG_BAIDU_SEARCH_API_URL=https://qianfan.baidubce.com/v2/ai_search
SRBG_BAIDU_SEARCH_API_KEY=
SRBG_BAIDU_SEARCH_TIMEOUT_SECONDS=2
SRBG_BAIDU_SEARCH_MONTHLY_CAP_MICRORMB=200000000
SRBG_BAIDU_SEARCH_COST_PER_CALL_MICRORMB=36000
SRBG_BAIDU_SEARCH_FREE_CALLS_PER_MONTH=1500
SRBG_BAIDU_SEARCH_BUDGET_ALERT_BPS=8000
SRBG_METRICS_BEARER_TOKEN=demo-only-round11-metrics-token-000000
SRBG_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
SRBG_SENTRY_DSN=
# PERS-01 personal APIs are local-only. These OIDC values are retained for legacy paths.
SRBG_OIDC_ISSUER=
SRBG_OIDC_AUDIENCE=
SRBG_OIDC_JWKS_URL=
SRBG_ALERT_WEBHOOK_URL=

# Round 17 remains fail-closed when these are absent. Uncomment only after LEO has
# approved the exact immutable values and the real non-local OIDC actor is bound.

# Backups must use an independent endpoint in production.
SRBG_BACKUP_S3_ENDPOINT_URL=http://minio:9000
SRBG_BACKUP_S3_BUCKET=srbg-backup
SRBG_BACKUP_S3_ACCESS_KEY=srbg_local
SRBG_BACKUP_S3_SECRET_KEY=srbg_local_storage_only

# Isolated AI Worker. Production defaults to DeepSeek; mock is test-only.
# Only the pinned DeepSeek capability may make a real call in R-AI01.
SRBG_AI_BROKER_URL=redis://redis:6379/0
SRBG_AI_PROVIDER=deepseek
SRBG_AI_API_KEY=
SRBG_AI_API_KEY_FILE=/run/secrets/srbg-ai/deepseek.key
SRBG_AI_SECRET_DIR=/run/secrets/srbg-ai
SRBG_AI_TIMEOUT_SECONDS=30

# Loopback-only host ports; change only when a local port is already occupied.
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
