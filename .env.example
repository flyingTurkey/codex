# DEVELOPMENT-ONLY values for the local Compose stack. Never reuse in production.
POSTGRES_DB=srbg
POSTGRES_USER=srbg
POSTGRES_PASSWORD=srbg_local_only
MINIO_ROOT_USER=srbg_local
MINIO_ROOT_PASSWORD=srbg_local_storage_only

# Application configuration. All external I/O is bounded by this timeout.
SRBG_ENVIRONMENT=demo
SRBG_DATABASE_URL=postgresql+asyncpg://srbg:srbg_local_only@postgres:5432/srbg
SRBG_REDIS_URL=redis://redis:6379/0
SRBG_S3_ENDPOINT_URL=http://minio:9000
SRBG_S3_ACCESS_KEY=srbg_local
SRBG_S3_SECRET_KEY=srbg_local_storage_only
SRBG_S3_BUCKET=srbg-raw
SRBG_S3_REGION=us-east-1
SRBG_EXTERNAL_IO_TIMEOUT_SECONDS=2

# Loopback-only host ports; change only when a local port is already occupied.
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
